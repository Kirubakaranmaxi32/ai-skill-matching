# ==============================================================================
# AI Skill Matching - Environment Configuration Template (Phase 2)
# Copy this file to .env in backend/ and frontend/ before running live services.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true

# API Configuration
API_V1_STR=/api/v1
SECRET_KEY=change-me-to-a-secure-secret-key-in-production

# Network & CORS Settings
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend Supabase Integration (Required for Live Client Auth)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Backend Supabase Integration (Required for Token & Database Verification)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
